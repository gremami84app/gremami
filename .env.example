# Configuración de Backend Supabase para Gremami P2P
#
# IMPORTANTE: el código NO trae credenciales por defecto (no hay fallback).
# Si estas dos variables faltan o son inválidas, la app arranca en
# "modo no configurado": sin Supabase, con aviso en la consola y en la UI.
#
# Copiá este archivo a .env y completá con los datos de tu proyecto:
#   Supabase Dashboard -> Project Settings -> API Keys
#
# Usá SOLO la clave "publishable" / "anon".
# NUNCA pongas acá la "service_role" / secret key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
